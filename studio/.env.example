# WQL Studio environment. Copy to .env.local for local work and add the same keys in
# Vercel → Project → Settings → Environment Variables. Everything except NEXT_PUBLIC_* stays on the server.
# Never commit real values.

# --- Supabase (Project Settings → API Keys) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dtwjcenbduybmerfrglb.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Bypasses RLS. Server only: cron jobs and owner-checked actions.
SUPABASE_SECRET_KEY=

# --- Who may sign in ----------------------------------------------------------------------
# The one email allowed to request a magic link. Must also be in the app_owner table.
OWNER_EMAIL=
# Public URL of the deployed app, used in magic links (e.g. https://wql-studio.vercel.app).
# Optional: falls back to the request's origin.
SITE_URL=

# --- YouTube Data API v3 (Google Cloud → APIs & Services → Credentials) --------------------
# API key restricted to "YouTube Data API v3". Public data only.
YOUTUBE_API_KEY=
# Daily quota of your Google Cloud project (default 10,000 units, resets at midnight Pacific).
YOUTUBE_DAILY_QUOTA=10000
# Share of the quota kept for the essential daily sync; other calls stop above 1 − this (0.1 → 90%).
YOUTUBE_QUOTA_RESERVE=0.1

# --- Vercel Cron ----------------------------------------------------------------------------
# Random string of 32+ characters. Vercel sends it as "Authorization: Bearer …" to /api/cron/*.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Later phases (not used yet) ------------------------------------------------------------
# ANTHROPIC_API_KEY=             # Phase 2+: clustering, scripts, fact-checks, scoring
# GITHUB_TOKEN=                  # Phase 3: fine-grained token, contents:write on this repo only
# GOOGLE_OAUTH_CLIENT_ID=        # Phase 5: YouTube Analytics (read-only)
# GOOGLE_OAUTH_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=          # Phase 5: encrypts the stored OAuth refresh token
